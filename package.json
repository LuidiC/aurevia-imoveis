{
  "name": "aurevia-imoveis",
  "version": "0.1.0",
  "private": true,
  "description": "Site institucional e catálogo de imóveis da Aurévia Imóveis.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/**/*.test.ts",
    "property:list": "tsx scripts/properties/cli.ts list",
    "property:add": "tsx scripts/properties/cli.ts add",
    "property:next-id": "tsx scripts/properties/cli.ts next-id",
    "property:edit": "tsx scripts/properties/cli.ts edit",
    "property:remove": "tsx scripts/properties/cli.ts remove",
    "property:delete": "tsx scripts/properties/cli.ts delete",
    "property:activate": "tsx scripts/properties/cli.ts activate",
    "property:validate": "tsx scripts/properties/cli.ts validate",
    "check": "npm run lint && npm run typecheck && npm run test && npm run property:validate && npm run build"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "npm@11.11.0",
  "dependencies": {
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.1",
    "postcss": "8.5.26",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.12",
    "typescript": "6.0.3"
  }
}
